{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_empirex_rules_status" class="form-control">
                <option value="1"{% if shipping_empirex_rules_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not shipping_empirex_rules_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_default_cost }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_empirex_rules_default_cost" value="{{ shipping_empirex_rules_default_cost }}" class="form-control"/>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_free_from }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_empirex_rules_free_from" value="{{ shipping_empirex_rules_free_from }}" class="form-control"/>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_city_rates }}</label>
            <div class="col-sm-10">
              <textarea name="shipping_empirex_rules_city_rates" rows="6" class="form-control" placeholder="Cluj-Napoca=14.90">{{ shipping_empirex_rules_city_rates }}</textarea>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_country_rates }}</label>
            <div class="col-sm-10">
              <textarea name="shipping_empirex_rules_country_rates" rows="4" class="form-control" placeholder="RO=19.90">{{ shipping_empirex_rules_country_rates }}</textarea>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_blocked }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_empirex_rules_blocked_prefixes" value="{{ shipping_empirex_rules_blocked_prefixes }}" class="form-control" placeholder="07,98"/>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_heavy }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_empirex_rules_heavy_weight" value="{{ shipping_empirex_rules_heavy_weight }}" class="form-control"/>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_surcharge }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_empirex_rules_heavy_surcharge" value="{{ shipping_empirex_rules_heavy_surcharge }}" class="form-control"/>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="shipping_empirex_rules_geo_zone_id" class="form-control">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_empirex_rules_geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_empirex_rules_sort_order" value="{{ shipping_empirex_rules_sort_order }}" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
